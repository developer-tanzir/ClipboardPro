    <string name="monitor_dialog_title">Background monitoring</string>
    <string name="monitor_dialog_message">This keeps a small notification running.\n\nOn Android 9 and below it can save copies from any app. On Android 10 and above, Android blocks background clipboard reads, so it only helps while ClipboardPro is on screen. Use the “Save clipboard” notification button for everything else.</string>
