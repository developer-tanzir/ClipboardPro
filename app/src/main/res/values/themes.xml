<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ClipboardPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_pink</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/pink_container</item>
        <item name="colorOnPrimaryContainer">@color/on_pink_container</item>
        <item name="colorSecondary">@color/brand_pink</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/pink_container</item>
        <item name="colorOnSecondaryContainer">@color/on_pink_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>

    <style name="Theme.ClipboardPro.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar" />

    <style name="ClipCategoryChip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_pink_container</item>
    </style>

    <style name="SettingTitle">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingSummary">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingSection">
        <item name="android:textColor">@color/brand_pink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>
